GEOAPIFY_API_KEY=your_free_geoapify_key_here
EXPO_PUBLIC_API_BASE_URL=https://your-live-backend.example.com
# Optional. Use `osrm` for the public OSRM demo, `geoapify` for Geoapify road timings,
# `google` for Google Distance Matrix, or `haversine` for straight-line estimates.
DISTANCE_PROVIDER=osrm
# Optional. Leave blank to use the public OSRM demo server while testing.
OSRM_BASE_URL=https://router.project-osrm.org
